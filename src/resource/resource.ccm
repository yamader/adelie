export module adelie.resource;

import std;
import adelie.facades.config;
import adelie.http;

namespace adelie::resource::detail {

struct MimeEntry {
  std::string_view extension;
  std::string_view type;
};

constexpr std::array mime_table{
    MimeEntry{".html", "text/html; charset=utf-8"},
    MimeEntry{".htm", "text/html; charset=utf-8"},
    MimeEntry{".css", "text/css; charset=utf-8"},
    MimeEntry{".js", "text/javascript; charset=utf-8"},
    MimeEntry{".mjs", "text/javascript; charset=utf-8"},
    MimeEntry{".json", "application/json"},
    MimeEntry{".xml", "application/xml; charset=utf-8"},
    MimeEntry{".txt", "text/plain; charset=utf-8"},
    MimeEntry{".md", "text/markdown; charset=utf-8"},
    MimeEntry{".csv", "text/csv; charset=utf-8"},
    MimeEntry{".svg", "image/svg+xml"},
    MimeEntry{".png", "image/png"},
    MimeEntry{".jpg", "image/jpeg"},
    MimeEntry{".jpeg", "image/jpeg"},
    MimeEntry{".gif", "image/gif"},
    MimeEntry{".webp", "image/webp"},
    MimeEntry{".avif", "image/avif"},
    MimeEntry{".ico", "image/x-icon"},
    MimeEntry{".woff", "font/woff"},
    MimeEntry{".woff2", "font/woff2"},
    MimeEntry{".ttf", "font/ttf"},
    MimeEntry{".otf", "font/otf"},
    MimeEntry{".pdf", "application/pdf"},
    MimeEntry{".zip", "application/zip"},
    MimeEntry{".gz", "application/gzip"},
    MimeEntry{".wasm", "application/wasm"},
    MimeEntry{".mp4", "video/mp4"},
    MimeEntry{".webm", "video/webm"},
    MimeEntry{".mp3", "audio/mpeg"},
    MimeEntry{".ogg", "audio/ogg"},
    MimeEntry{".wav", "audio/wav"},
};

auto lowered(std::string_view value) -> std::string {
  std::string out;
  out.reserve(value.size());
  for (char const c : value) out.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(c))));
  return out;
}

auto contained(std::filesystem::path const& base, std::string_view relative)
    -> std::expected<std::filesystem::path, std::string> {
  if (relative.empty()) return std::unexpected{"empty resource path"};

  std::filesystem::path const requested{relative};
  if (requested.is_absolute())
    return std::unexpected{"resource path must be relative: \"" + std::string{relative} + '"'};

  std::error_code ec;
  auto const canonical_base = std::filesystem::weakly_canonical(base, ec);
  if (ec) return std::unexpected{"cannot resolve resource root \"" + base.string() + "\": " + ec.message()};

  auto const full = std::filesystem::weakly_canonical(canonical_base / requested, ec);
  if (ec) return std::unexpected{"cannot resolve resource \"" + std::string{relative} + "\": " + ec.message()};

  auto const inside = full.lexically_relative(canonical_base);
  if (inside.empty() || *inside.begin() == "..")
    return std::unexpected{"resource path escapes the resource root: \"" + std::string{relative} + '"'};

  return full;
}

}

export namespace adelie::resource {

auto mime_type_for(std::string_view extension) noexcept -> std::string_view {
  for (auto const& entry : detail::mime_table)
    if (entry.extension == extension) return entry.type;
  return "application/octet-stream";
}

auto root() -> std::filesystem::path {
  return std::filesystem::path{facades::Config::get("resource.path", "resources")};
}

class Resource {
 public:
  static auto at(std::filesystem::path const& base, std::string_view relative) -> Resource {
    auto const full = detail::contained(base, relative);
    if (!full) throw std::invalid_argument{"adelie: " + full.error()};
    return Resource{std::string{relative}, *full};
  }

  static auto find(std::filesystem::path const& base, std::string_view relative) -> std::optional<Resource> {
    auto const full = detail::contained(base, relative);
    if (!full) return std::nullopt;

    Resource candidate{std::string{relative}, *full};
    if (!candidate.is_file()) return std::nullopt;
    return candidate;
  }

  auto relative_path() const noexcept -> std::string_view { return relative_; }

  auto path() const noexcept -> std::filesystem::path const& { return path_; }

  auto exists() const -> bool {
    std::error_code ec;
    return std::filesystem::exists(path_, ec);
  }

  auto is_file() const -> bool {
    std::error_code ec;
    return std::filesystem::is_regular_file(path_, ec);
  }

  auto size() const -> std::uintmax_t {
    std::error_code ec;
    auto const value = std::filesystem::file_size(path_, ec);
    return ec ? 0 : value;
  }

  auto last_modified() const -> std::filesystem::file_time_type {
    std::error_code ec;
    auto const value = std::filesystem::last_write_time(path_, ec);
    return ec ? std::filesystem::file_time_type{} : value;
  }

  auto extension() const -> std::string { return detail::lowered(path_.extension().string()); }

  auto mime_type() const -> std::string_view { return mime_type_for(extension()); }

  auto etag() const -> std::string {
    auto const ticks = static_cast<std::uint64_t>(last_modified().time_since_epoch().count());
    return std::format("\"{:x}-{:x}\"", size(), ticks);
  }

  auto stream() const -> std::ifstream {
    std::ifstream file{path_, std::ios::binary};
    if (!file) throw std::runtime_error{"adelie: cannot read resource \"" + relative_ + '"'};
    return file;
  }

  auto string() const -> std::string {
    auto file = stream();
    std::string out;
    out.reserve(static_cast<std::size_t>(size()));
    out.assign(std::istreambuf_iterator<char>{file}, std::istreambuf_iterator<char>{});
    return out;
  }

  auto bytes() const -> std::vector<std::byte> {
    auto const text = string();
    std::vector<std::byte> out;
    out.reserve(text.size());
    for (char const c : text) out.push_back(static_cast<std::byte>(static_cast<unsigned char>(c)));
    return out;
  }

  auto response(http::Status status = http::Status::ok) const -> http::Response {
    http::Response r{status, string()};
    r.set_header(http::Field::content_type, mime_type());
    return r;
  }

 private:
  Resource(std::string relative, std::filesystem::path resolved)
      : relative_{std::move(relative)}, path_{std::move(resolved)} {}

  std::string relative_;
  std::filesystem::path path_;
};

auto resource(std::string_view relative_path) -> resource::Resource {
  return resource::Resource::at(resource::root(), relative_path);
}

auto find_resource(std::string_view relative_path) -> std::optional<resource::Resource> {
  return resource::Resource::find(resource::root(), relative_path);
}

}
