module;

#include <memory>
#include <string_view>

export module adelie.db:connector;

import :session;
import :types;

export namespace adelie::db {

class Connector {
 public:
  virtual ~Connector() = default;

  virtual auto driver() const noexcept -> std::string_view = 0;
  virtual auto open(Config const& config) -> std::unique_ptr<Session> = 0;
};

}
