module;

#include <algorithm>
#include <cstdint>
#include <ctime>
#include <map>
#include <optional>
#include <stdexcept>
#include <string>
#include <string_view>
#include <utility>
#include <vector>

export module adelie.db:model;

import :manager;
import :session;
import :types;

namespace adelie::db::detail {

inline auto is_alpha(char c) -> bool { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'); }
inline auto is_digit(char c) -> bool { return c >= '0' && c <= '9'; }

inline auto quoted(std::string_view name) -> std::string { return '"' + std::string(name) + '"'; }

inline auto validate_column(std::string_view column) -> std::string {
  if (column.empty() || !(is_alpha(column[0]) || column[0] == '_'))
    throw std::invalid_argument("adelie.db: invalid column name \"" + std::string(column) + '"');
  for (char const c : column)
    if (!is_alpha(c) && !is_digit(c) && c != '_')
      throw std::invalid_argument("adelie.db: invalid column name \"" + std::string(column) + '"');
  return std::string(column);
}

inline auto validate_op(std::string_view op) -> std::string_view {
  static constexpr std::string_view allowed[] = {"=", "!=", "<", "<=", ">", ">=", "LIKE"};
  for (auto const& candidate : allowed)
    if (op == candidate) return op;
  throw std::invalid_argument("adelie.db: invalid operator \"" + std::string(op) + '"');
}

inline auto snake_plural(std::string_view name) -> std::string {
  std::string out;
  out.reserve(name.size() + 2);
  for (char const c : name) {
    if (c >= 'A' && c <= 'Z') {
      if (!out.empty()) out += '_';
      out += static_cast<char>(c - 'A' + 'a');
    } else {
      out += c;
    }
  }
  out += 's';
  return out;
}

inline auto current_time() -> std::string {
  std::time_t const now = std::time(nullptr);
  std::tm tm{};
  ::gmtime_r(&now, &tm);
  char buffer[32] = {};
  std::strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", &tm);
  return buffer;
}

inline auto json_escape(std::string_view text) -> std::string {
  std::string out;
  out.reserve(text.size() + 2);
  for (char const c : text) {
    switch (c) {
      case '"':
        out += "\\\"";
        break;
      case '\\':
        out += "\\\\";
        break;
      case '\n':
        out += "\\n";
        break;
      case '\r':
        out += "\\r";
        break;
      case '\t':
        out += "\\t";
        break;
      default:
        out += c;
        break;
    }
  }
  return out;
}

inline auto json_value(Value const& value) -> std::string {
  switch (value.type()) {
    case ValueType::null:
      return "null";
    case ValueType::integer:
      return std::to_string(value.as_int());
    case ValueType::real:
      return std::to_string(value.as_double());
    case ValueType::text:
      return '"' + json_escape(value.as_string()) + '"';
    default:
      return "\"\"";
  }
}

template <class T>
inline auto type_name() -> std::string_view {
  std::string_view const pretty = __PRETTY_FUNCTION__;
  auto const marker = pretty.find("T = ");
  if (marker == std::string_view::npos) return {};
  auto const start = marker + 4;
  auto const end = pretty.find_first_of("];", start);
  auto name = pretty.substr(start, end == std::string_view::npos ? pretty.size() - start : end - start);
  if (auto const scope = name.rfind("::"); scope != std::string_view::npos) name.remove_prefix(scope + 2);
  return name;
}

}

export namespace adelie::db {

template <class T>
class Model {
 public:
  static constexpr std::string_view primary_key = "id";
  static constexpr std::string_view connection = "default";
  static constexpr bool timestamps = true;
  static constexpr std::string_view created_at_column = "created_at";
  static constexpr std::string_view updated_at_column = "updated_at";

  virtual ~Model() = default;

  class Builder;

  static auto table_name() -> std::string_view {
    if constexpr (requires { T::table; }) return T::table;
    return named_table();
  }

  static auto key_name() -> std::string_view { return T::primary_key; }
  static auto connection_name() -> std::string_view { return T::connection; }
  static auto timestamps_enabled() -> bool { return T::timestamps; }

  auto attributes() -> std::map<std::string, Value>& { return attributes_; }
  auto attributes() const -> std::map<std::string, Value> const& { return attributes_; }

  auto has(std::string_view name) const -> bool { return attributes_.find(std::string(name)) != attributes_.end(); }

  auto get(std::string_view name) const -> Value const& {
    auto const it = attributes_.find(std::string(name));
    return it != attributes_.end() ? it->second : null_value();
  }

  auto set(std::string_view name, Value value) -> void { attributes_[std::string(name)] = std::move(value); }

  auto remove(std::string_view name) -> bool { return attributes_.erase(std::string(name)) > 0; }

  auto operator[](std::string_view name) -> Value& { return attributes_[std::string(name)]; }
  auto operator[](std::string_view name) const -> Value const& { return get(name); }

  auto fill(std::map<std::string, Value> attributes) -> void {
    auto const fillable_columns = fillable();
    auto const guarded_columns = guarded();
    for (auto& [column, value] : attributes) {
      bool allowed = false;
      if (!fillable_columns.empty()) {
        allowed = std::find(fillable_columns.begin(), fillable_columns.end(), column) != fillable_columns.end() &&
                  std::find(guarded_columns.begin(), guarded_columns.end(), column) == guarded_columns.end();
      } else if (!guarded_columns.empty()) {
        allowed = std::find(guarded_columns.begin(), guarded_columns.end(), column) == guarded_columns.end();
      }
      if (allowed) attributes_[column] = std::move(value);
    }
  }

  virtual auto fillable() const -> std::vector<std::string_view> { return {}; }
  virtual auto guarded() const -> std::vector<std::string_view> { return {}; }

  auto save() -> bool {
    auto& s = session();
    return exists_ ? update_record(s) : insert_record(s);
  }

  auto update(std::map<std::string, Value> attributes) -> bool {
    fill(std::move(attributes));
    return save();
  }

  auto remove() -> bool {
    if (!exists_) return false;
    auto& s = session();
    auto const key = std::string(key_name());
    auto const it = attributes_.find(key);
    if (it == attributes_.end()) return false;
    s.execute("DELETE FROM " + detail::quoted(table_name()) + " WHERE " + detail::quoted(key) + " = ?", {it->second});
    bool const removed = s.affected_rows() > 0;
    exists_ = false;
    return removed;
  }

  auto exists() const noexcept -> bool { return exists_; }

  auto key() const -> std::int64_t {
    auto const it = attributes_.find(std::string(key_name()));
    if (it == attributes_.end()) return 0;
    try {
      return it->second.as_int();
    } catch (...) {
      return 0;
    }
  }

  auto to_array() const -> std::map<std::string, Value> { return attributes_; }

  auto to_json() const -> std::string {
    std::string out = "{";
    for (auto const& [column, value] : attributes_) {
      if (out.size() > 1) out += ',';
      out += '"' + detail::json_escape(column) + "\":" + detail::json_value(value);
    }
    out += '}';
    return out;
  }

  static auto query() -> Builder { return Builder{}; }
  static auto all() -> std::vector<T> { return query().get(); }
  static auto find(std::int64_t key) -> std::optional<T> { return query().find(key); }
  static auto find(std::string_view key) -> std::optional<T> { return query().find(key); }
  static auto first() -> std::optional<T> { return query().first(); }
  static auto count() -> std::int64_t { return query().count(); }

  static auto where(std::string_view column, Value value) -> Builder { return query().where(column, std::move(value)); }
  static auto where(std::string_view column, std::string_view op, Value value) -> Builder {
    return query().where(column, op, std::move(value));
  }

  static auto create(std::map<std::string, Value> attributes) -> T {
    T model;
    model.fill(std::move(attributes));
    model.save();
    return model;
  }

  class Builder {
   public:
    auto where(std::string_view column, Value value) -> Builder& { return where(column, "=", std::move(value)); }

    auto where(std::string_view column, std::string_view op, Value value) -> Builder& {
      clauses_.push_back(
          {false, detail::validate_column(column), std::string(detail::validate_op(op)), std::move(value)});
      return *this;
    }

    auto or_where(std::string_view column, Value value) -> Builder& { return or_where(column, "=", std::move(value)); }

    auto or_where(std::string_view column, std::string_view op, Value value) -> Builder& {
      clauses_.push_back(
          {true, detail::validate_column(column), std::string(detail::validate_op(op)), std::move(value)});
      return *this;
    }

    auto order_by(std::string_view column, std::string_view direction = "asc") -> Builder& {
      order_.column = detail::validate_column(column);
      order_.direction = (direction == "desc") ? "desc" : "asc";
      return *this;
    }

    auto limit(std::int64_t value) -> Builder& {
      limit_ = value;
      return *this;
    }

    auto offset(std::int64_t value) -> Builder& {
      offset_ = value;
      return *this;
    }

    auto get() -> std::vector<T> { return from_rows(session().execute(select_sql(), params())); }

    auto first() -> std::optional<T> {
      auto rows = session().execute(select_sql(1), params());
      if (rows.empty()) return std::nullopt;
      return Model<T>::from_row(rows[0]);
    }

    auto find(std::int64_t key) -> std::optional<T> { return where(Model<T>::key_name(), key).first(); }
    auto find(std::string_view key) -> std::optional<T> { return where(Model<T>::key_name(), key).first(); }

    auto count() -> std::int64_t {
      std::string sql = "SELECT COUNT(*) FROM " + detail::quoted(Model<T>::table_name()) + where_sql();
      auto rows = session().execute(sql, params());
      if (rows.empty() || rows[0].size() == 0) return 0;
      return rows[0][0].as_int();
    }

    auto exists() -> bool { return count() > 0; }

    auto update(std::map<std::string, Value> attributes) -> bool {
      if (attributes.empty()) return false;
      std::string sql = "UPDATE " + detail::quoted(Model<T>::table_name()) + " SET ";
      std::vector<Value> all_params;
      all_params.reserve(attributes.size() + clauses_.size());
      for (auto const& [column, value] : attributes) {
        sql += detail::quoted(detail::validate_column(column)) + " = ?, ";
        all_params.push_back(value);
      }
      sql.pop_back();
      sql.pop_back();
      sql += where_sql();
      auto const clause_params = params();
      all_params.insert(all_params.end(), clause_params.begin(), clause_params.end());
      auto& s = session();
      s.execute(sql, all_params);
      return s.affected_rows() > 0;
    }

    auto remove() -> std::int64_t {
      auto& s = session();
      s.execute("DELETE FROM " + detail::quoted(Model<T>::table_name()) + where_sql(), params());
      return s.affected_rows();
    }

    auto to_sql() const -> std::string { return select_sql(); }

   private:
    struct Clause {
      bool or_ = false;
      std::string column;
      std::string op;
      Value value;
    };
    struct Order {
      std::string column;
      std::string direction = "asc";
    };

    std::vector<Clause> clauses_;
    Order order_;
    std::optional<std::int64_t> limit_;
    std::optional<std::int64_t> offset_;

    auto session() -> Session& { return default_manager().session(Model<T>::connection_name()); }

    auto where_sql() const -> std::string {
      if (clauses_.empty()) return "";
      std::string out = " WHERE ";
      for (std::size_t i = 0; i < clauses_.size(); ++i) {
        if (i > 0) out += clauses_[i].or_ ? " OR " : " AND ";
        out += detail::quoted(clauses_[i].column) + ' ' + clauses_[i].op + " ?";
      }
      return out;
    }

    auto params() const -> std::vector<Value> {
      std::vector<Value> out;
      out.reserve(clauses_.size());
      for (auto const& clause : clauses_) out.push_back(clause.value);
      return out;
    }

    auto select_sql(std::optional<std::int64_t> force_limit = std::nullopt) const -> std::string {
      std::string sql = "SELECT * FROM " + detail::quoted(Model<T>::table_name()) + where_sql();
      if (!order_.column.empty()) sql += " ORDER BY " + detail::quoted(order_.column) + ' ' + order_.direction;
      if (limit_ || force_limit) sql += " LIMIT " + std::to_string(limit_ ? *limit_ : *force_limit);
      if (offset_) sql += " OFFSET " + std::to_string(*offset_);
      return sql;
    }

    auto from_rows(ResultSet const& rows) -> std::vector<T> {
      std::vector<T> out;
      out.reserve(rows.size());
      for (auto const& row : rows) out.push_back(Model<T>::from_row(row));
      return out;
    }
  };

 private:
  auto session() -> Session& { return default_manager().session(connection_name()); }

  auto insert_record(Session& s) -> bool {
    bool const explicit_key = has(key_name()) && !get(key_name()).is_null();
    if (T::timestamps) {
      if (!has(T::created_at_column)) set(T::created_at_column, detail::current_time());
      set(T::updated_at_column, detail::current_time());
    }
    std::vector<std::string> columns;
    std::vector<Value> params;
    for (auto const& [column, value] : attributes_) {
      if (column == key_name() && !explicit_key) continue;
      columns.push_back(column);
      params.push_back(value);
    }
    if (columns.empty()) return false;
    std::string sql = "INSERT INTO " + detail::quoted(table_name()) + " (";
    for (auto const& column : columns) sql += detail::quoted(column) + ',';
    sql.back() = ')';
    sql += " VALUES (";
    for (std::size_t i = 0; i < columns.size(); ++i) sql += "?,";
    sql.back() = ')';
    s.execute(sql, params);
    if (!explicit_key) set(key_name(), s.last_insert_id());
    exists_ = true;
    return true;
  }

  auto update_record(Session& s) -> bool {
    if (T::timestamps) set(T::updated_at_column, detail::current_time());
    auto const key_it = attributes_.find(std::string(key_name()));
    if (key_it == attributes_.end()) return false;
    std::vector<std::string> columns;
    std::vector<Value> params;
    for (auto const& [column, value] : attributes_) {
      if (column == key_name()) continue;
      columns.push_back(column);
      params.push_back(value);
    }
    if (columns.empty()) return true;
    std::string sql = "UPDATE " + detail::quoted(table_name()) + " SET ";
    for (auto const& column : columns) sql += detail::quoted(column) + " = ?, ";
    sql.pop_back();
    sql.pop_back();
    sql += " WHERE " + detail::quoted(key_name()) + " = ?";
    params.push_back(key_it->second);
    s.execute(sql, params);
    return true;
  }

  static auto from_row(Row const& row) -> T {
    T model;
    for (auto const& name : row.names()) model.attributes_[name] = row[name];
    model.exists_ = true;
    return model;
  }

  static auto named_table() -> std::string_view {
    static std::string const table = detail::snake_plural(detail::type_name<T>());
    return table;
  }

  static auto null_value() -> Value const& {
    static Value const value{nullptr};
    return value;
  }

  bool exists_ = false;
  std::map<std::string, Value> attributes_;
};

}
