export module adelie.auth;

import std;
import adelie.http;
import adelie.routing.route;
import adelie.support.callable;

export namespace adelie::auth {

struct User {
  std::string id;
  std::string name;
  std::string role;
};

constexpr std::string_view user_id_key = "user_id";
constexpr std::string_view user_name_key = "user_name";
constexpr std::string_view user_role_key = "user_role";

class SessionStore {
 public:
  virtual ~SessionStore() = default;
  virtual auto load(std::string_view id) -> std::optional<http::Session> = 0;
  virtual auto save(http::Session const& session) -> void = 0;
  virtual auto destroy(std::string_view id) -> void = 0;
};

class MemorySessionStore final : public SessionStore {
 public:
  auto load(std::string_view id) -> std::optional<http::Session> override;
  auto save(http::Session const& session) -> void override;
  auto destroy(std::string_view id) -> void override;

 private:
  mutable std::mutex mutex_;
  std::map<std::string, http::Session, std::less<>> entries_;
};

class Authenticator {
 public:
  using TokenVerifier = support::Callable<std::optional<User>(std::string_view)>;
  using BasicVerifier = support::Callable<std::optional<User>(std::string_view, std::string_view)>;

  explicit Authenticator(SessionStore& store) : Authenticator{store, "session"} {}
  Authenticator(SessionStore& store, std::string_view cookie_name);

  auto verify_bearer(TokenVerifier verifier) -> Authenticator&;
  auto verify_basic(BasicVerifier verifier) -> Authenticator&;

  auto find_user_by_token(std::string_view token) const -> std::optional<User>;
  auto find_user_by_credentials(std::string_view username, std::string_view password) const -> std::optional<User>;

  auto cookie_name() const noexcept -> std::string_view;

  auto middleware() const -> routing::Middleware;

  auto issue(http::Request const& request, http::Response& response, User user) -> void;
  auto destroy(http::Request const& request, http::Response& response) -> void;

 private:
  SessionStore* store_;
  std::string cookie_name_;
  TokenVerifier bearer_verifier_;
  BasicVerifier basic_verifier_;
};

auto bearer_token(http::Request const& request) -> std::string_view;
auto basic_credentials(http::Request const& request) -> std::pair<std::string, std::string>;
auto current_user(http::Request const& request) -> std::optional<User>;

auto authenticator() -> Authenticator&;
auto login(http::Request const& request) -> http::Response;
auto logout(http::Request const& request) -> http::Response;

auto parse_cookie(http::Request const& request, std::string_view name) -> std::string;
auto make_cookie(std::string_view name, std::string_view value) -> std::string;
auto clear_cookie(std::string_view name) -> std::string;

}

namespace adelie::auth {

namespace {

constexpr std::string_view bearer_prefix = "Bearer ";
constexpr std::string_view basic_prefix = "Basic ";

auto decode_base64(std::string_view input) -> std::string {
  auto const value = [](char c) -> int {
    if (c >= 'A' && c <= 'Z') return c - 'A';
    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
    if (c >= '0' && c <= '9') return c - '0' + 52;
    if (c == '+') return 62;
    if (c == '/') return 63;
    return -1;
  };

  std::string out;
  int buffer = 0;
  int bits = 0;
  for (char const c : input) {
    if (c == '=' || c == '\r' || c == '\n' || c == ' ') continue;
    auto const v = value(c);
    if (v < 0) break;
    buffer = (buffer << 6) | v;
    bits += 6;
    if (bits < 8) continue;
    bits -= 8;
    out.push_back(static_cast<char>((buffer >> bits) & 0xFF));
  }
  return out;
}

auto trim(std::string_view s) -> std::string_view {
  while (!s.empty() && (s.front() == ' ' || s.front() == '\t')) s.remove_prefix(1);
  while (!s.empty() && (s.back() == ' ' || s.back() == '\t')) s.remove_suffix(1);
  return s;
}

}

auto attach_user(http::Session& session, User const& user) -> void {
  session.set(user_id_key, user.id).set(user_name_key, user.name).set(user_role_key, user.role);
  session.set_authenticated(true);
}

auto MemorySessionStore::load(std::string_view id) -> std::optional<http::Session> {
  std::lock_guard<std::mutex> lock(mutex_);
  auto const it = entries_.find(id);
  if (it == entries_.end()) return std::nullopt;
  return it->second;
}

auto MemorySessionStore::save(http::Session const& session) -> void {
  std::lock_guard<std::mutex> lock(mutex_);
  entries_[std::string{session.id()}] = session;
}

auto MemorySessionStore::destroy(std::string_view id) -> void {
  std::lock_guard<std::mutex> lock(mutex_);
  entries_.erase(std::string{id});
}

Authenticator::Authenticator(SessionStore& store, std::string_view cookie_name)
    : store_(&store), cookie_name_(cookie_name) {}

auto Authenticator::verify_bearer(TokenVerifier verifier) -> Authenticator& {
  bearer_verifier_ = std::move(verifier);
  return *this;
}

auto Authenticator::verify_basic(BasicVerifier verifier) -> Authenticator& {
  basic_verifier_ = std::move(verifier);
  return *this;
}

auto Authenticator::find_user_by_token(std::string_view token) const -> std::optional<User> {
  if (token.empty() || !bearer_verifier_) return std::nullopt;
  return bearer_verifier_(token);
}

auto Authenticator::find_user_by_credentials(std::string_view username, std::string_view password) const
    -> std::optional<User> {
  if (username.empty() || !basic_verifier_) return std::nullopt;
  return basic_verifier_(username, password);
}

auto Authenticator::cookie_name() const noexcept -> std::string_view { return cookie_name_; }

auto Authenticator::middleware() const -> routing::Middleware {
  return [this](http::Request& request, routing::Next const& next) -> http::Response {
    auto& session = request.session();
    bool from_cookie = false;

    auto const sid = parse_cookie(request, cookie_name_);
    if (!sid.empty()) {
      if (auto restored = store_->load(sid)) {
        session = std::move(*restored);
        from_cookie = true;
      }
    }

    if (!session.authenticated()) {
      if (auto const token = bearer_token(request); !token.empty()) {
        if (auto user = find_user_by_token(token)) attach_user(session, *user);
      } else if (auto const [username, password] = basic_credentials(request); !username.empty()) {
        if (auto user = find_user_by_credentials(username, password)) attach_user(session, *user);
      }
    }

    if (!session.authenticated())
      return http::Response::json({{"error", "unauthorized"}}, http::Status::unauthorized)
          .set_header(http::Field::www_authenticate, "Bearer realm=\"adelie\", Basic realm=\"adelie\"");

    auto response = next();

    if (from_cookie) {
      if (session.id().empty()) session.set_id(sid);
      store_->save(session);
      response.set_header(http::Field::set_cookie, make_cookie(cookie_name_, session.id()));
    }

    return response;
  };
}

auto Authenticator::issue(http::Request const& request, http::Response& response, User user) -> void {
  auto& session = request.session();
  attach_user(session, user);
  session.assign_id();
  store_->save(session);
  response.set_header(http::Field::set_cookie, make_cookie(cookie_name_, session.id()));
}

auto Authenticator::destroy(http::Request const& request, http::Response& response) -> void {
  auto const sid = parse_cookie(request, cookie_name_);
  if (!sid.empty()) store_->destroy(sid);
  request.session().clear();
  response.set_header(http::Field::set_cookie, clear_cookie(cookie_name_));
}

auto authenticator() -> Authenticator& {
  static MemorySessionStore store;
  static Authenticator instance{store, "adelie_session"};
  return instance;
}

auto login(http::Request const& request) -> http::Response {
  auto& auth = authenticator();
  auto const [username, password] = basic_credentials(request);
  auto user = auth.find_user_by_credentials(username, password);
  if (!user) return http::Response::json({{"error", "invalid credentials"}}, http::Status::unauthorized);
  auto response = http::Response::json({{"id", user->id}, {"name", user->name}, {"role", user->role}});
  auth.issue(request, response, *user);
  return response;
}

auto logout(http::Request const& request) -> http::Response {
  auto& auth = authenticator();
  auto response = http::Response::no_content();
  auth.destroy(request, response);
  return response;
}

auto bearer_token(http::Request const& request) -> std::string_view {
  auto const header = request.header(http::Field::authorization);
  if (header.size() <= bearer_prefix.size() || header.substr(0, bearer_prefix.size()) != bearer_prefix) return {};
  return trim(header.substr(bearer_prefix.size()));
}

auto basic_credentials(http::Request const& request) -> std::pair<std::string, std::string> {
  auto const header = request.header(http::Field::authorization);
  if (header.size() <= basic_prefix.size() || header.substr(0, basic_prefix.size()) != basic_prefix) return {};
  auto const decoded = decode_base64(header.substr(basic_prefix.size()));
  auto const pos = decoded.find(':');
  if (pos == std::string::npos) return {};
  return {decoded.substr(0, pos), decoded.substr(pos + 1)};
}

auto current_user(http::Request const& request) -> std::optional<User> {
  auto const& session = request.session();
  if (!session.authenticated()) return std::nullopt;
  return User{std::string{session.get(user_id_key)}, std::string{session.get(user_name_key)},
              std::string{session.get(user_role_key)}};
}

auto parse_cookie(http::Request const& request, std::string_view name) -> std::string {
  auto const cookies = request.header(http::Field::cookie);
  std::size_t start = 0;
  for (;;) {
    auto const end = cookies.find(';', start);
    auto const part = cookies.substr(start, end == std::string_view::npos ? std::string_view::npos : end - start);
    auto const eq = part.find('=');
    if (trim(eq == std::string_view::npos ? part : part.substr(0, eq)) == name)
      return eq == std::string_view::npos ? std::string{} : std::string{trim(part.substr(eq + 1))};
    if (end == std::string_view::npos) return {};
    start = end + 1;
  }
}

auto make_cookie(std::string_view name, std::string_view value) -> std::string {
  return std::string{name} + "=" + std::string{value} + "; Path=/; HttpOnly; SameSite=Lax";
}

auto clear_cookie(std::string_view name) -> std::string { return std::string{name} + "=; Path=/; HttpOnly; Max-Age=0"; }

}
