export module adelie.support.callable;

import std;

export namespace adelie::support {

template <class Signature>
class Callable;

template <class R, class... Args>
class Callable<R(Args...)> {
 public:
  Callable() = default;

  template <class F>
    requires(!std::is_same_v<std::decay_t<F>, Callable> && std::is_invocable_r_v<R, std::decay_t<F>&, Args...>)
  Callable(F&& fn) : holder_{std::make_unique<Model<std::decay_t<F>>>(std::forward<F>(fn))} {}

  auto operator()(Args... args) const -> R { return holder_->invoke(std::forward<Args>(args)...); }

  explicit operator bool() const noexcept { return holder_.get() != nullptr; }

 private:
  struct Concept {
    virtual ~Concept() = default;
    virtual auto invoke(Args...) -> R = 0;
  };

  template <class F>
  struct Model final : Concept {
    explicit Model(F fn) : fn_{std::move(fn)} {}

    auto invoke(Args... args) -> R override { return fn_(std::forward<Args>(args)...); }

    F fn_;
  };

  std::unique_ptr<Concept> holder_;
};

}
