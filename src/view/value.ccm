export module adelie.view:value;

import std;

export namespace adelie::view {

class Value;
struct Member;

using Array = std::vector<Value>;
using Object = std::vector<Member>;

class Value {
 public:
  Value();
  Value(std::nullptr_t);
  Value(bool value);
  Value(int value);
  Value(std::int64_t value);
  Value(double value);
  Value(char const* value);
  Value(std::string_view value);
  Value(std::string value);
  Value(Array value);
  Value(Object value);
  Value(std::initializer_list<Member> members);

  Value(Value const& other);
  Value(Value&& other) noexcept;
  auto operator=(Value const& other) -> Value&;
  auto operator=(Value&& other) noexcept -> Value&;
  ~Value();

  static auto array(std::initializer_list<Value> items) -> Value;
  static auto object(std::initializer_list<Member> members) -> Value;

  auto is_null() const noexcept -> bool;
  auto is_bool() const noexcept -> bool;
  auto is_integer() const noexcept -> bool;
  auto is_double() const noexcept -> bool;
  auto is_number() const noexcept -> bool;
  auto is_string() const noexcept -> bool;
  auto is_array() const noexcept -> bool;
  auto is_object() const noexcept -> bool;

  auto as_bool() const -> bool;
  auto as_integer() const -> std::int64_t;
  auto as_double() const -> double;
  auto as_string() const -> std::string_view;
  auto as_array() const -> Array const&;
  auto as_object() const -> Object const&;

  auto find(std::string_view key) const noexcept -> Value const*;
  auto truthy() const noexcept -> bool;
  auto to_string() const -> std::string;

 private:
  struct Storage;
  std::unique_ptr<Storage> storage_;
};

struct Member {
  std::string key;
  Value value;
};

using Data = Object;

}

namespace adelie::view {

struct Value::Storage {
  std::variant<std::monostate, bool, std::int64_t, double, std::string, Array, Object> data;
};

namespace detail {

[[noreturn]] auto wrong_type(std::string_view wanted) -> void {
  throw std::runtime_error{"adelie: view value is not " + std::string{wanted}};
}

}

Value::Value() : storage_{std::make_unique<Storage>()} {}

Value::Value(std::nullptr_t) : Value{} {}

Value::Value(bool value) : storage_{std::make_unique<Storage>(Storage{value})} {}

Value::Value(int value) : storage_{std::make_unique<Storage>(Storage{static_cast<std::int64_t>(value)})} {}

Value::Value(std::int64_t value) : storage_{std::make_unique<Storage>(Storage{value})} {}

Value::Value(double value) : storage_{std::make_unique<Storage>(Storage{value})} {}

Value::Value(char const* value) : storage_{std::make_unique<Storage>(Storage{std::string{value}})} {}

Value::Value(std::string_view value) : storage_{std::make_unique<Storage>(Storage{std::string{value}})} {}

Value::Value(std::string value) : storage_{std::make_unique<Storage>(Storage{std::move(value)})} {}

Value::Value(Array value) : storage_{std::make_unique<Storage>(Storage{std::move(value)})} {}

Value::Value(Object value) : storage_{std::make_unique<Storage>(Storage{std::move(value)})} {}

Value::Value(std::initializer_list<Member> members) : storage_{std::make_unique<Storage>(Storage{Object{members}})} {}

Value::Value(Value const& other) : storage_{std::make_unique<Storage>(*other.storage_)} {}

Value::Value(Value&& other) noexcept = default;

auto Value::operator=(Value const& other) -> Value& {
  if (this != &other) *storage_ = *other.storage_;
  return *this;
}

auto Value::operator=(Value&& other) noexcept -> Value& = default;

Value::~Value() = default;

auto Value::array(std::initializer_list<Value> items) -> Value { return Value{Array{items}}; }

auto Value::object(std::initializer_list<Member> members) -> Value { return Value{Object{members}}; }

auto Value::is_null() const noexcept -> bool { return std::holds_alternative<std::monostate>(storage_->data); }

auto Value::is_bool() const noexcept -> bool { return std::holds_alternative<bool>(storage_->data); }

auto Value::is_integer() const noexcept -> bool { return std::holds_alternative<std::int64_t>(storage_->data); }

auto Value::is_double() const noexcept -> bool { return std::holds_alternative<double>(storage_->data); }

auto Value::is_number() const noexcept -> bool { return is_integer() || is_double(); }

auto Value::is_string() const noexcept -> bool { return std::holds_alternative<std::string>(storage_->data); }

auto Value::is_array() const noexcept -> bool { return std::holds_alternative<Array>(storage_->data); }

auto Value::is_object() const noexcept -> bool { return std::holds_alternative<Object>(storage_->data); }

auto Value::as_bool() const -> bool {
  if (!is_bool()) detail::wrong_type("a bool");
  return std::get<bool>(storage_->data);
}

auto Value::as_integer() const -> std::int64_t {
  if (is_double()) return static_cast<std::int64_t>(std::get<double>(storage_->data));
  if (!is_integer()) detail::wrong_type("a number");
  return std::get<std::int64_t>(storage_->data);
}

auto Value::as_double() const -> double {
  if (is_integer()) return static_cast<double>(std::get<std::int64_t>(storage_->data));
  if (!is_double()) detail::wrong_type("a number");
  return std::get<double>(storage_->data);
}

auto Value::as_string() const -> std::string_view {
  if (!is_string()) detail::wrong_type("a string");
  return std::get<std::string>(storage_->data);
}

auto Value::as_array() const -> Array const& {
  if (!is_array()) detail::wrong_type("an array");
  return std::get<Array>(storage_->data);
}

auto Value::as_object() const -> Object const& {
  if (!is_object()) detail::wrong_type("an object");
  return std::get<Object>(storage_->data);
}

auto Value::find(std::string_view key) const noexcept -> Value const* {
  if (!is_object()) return nullptr;
  for (auto const& member : std::get<Object>(storage_->data))
    if (member.key == key) return &member.value;
  return nullptr;
}

auto Value::truthy() const noexcept -> bool {
  return std::visit(
      []<class T>(T const& held) -> bool {
        if constexpr (std::is_same_v<T, std::monostate>)
          return false;
        else if constexpr (std::is_same_v<T, bool>)
          return held;
        else if constexpr (std::is_same_v<T, std::int64_t>)
          return held != 0;
        else if constexpr (std::is_same_v<T, double>)
          return held != 0.0;
        else
          return !held.empty();
      },
      storage_->data);
}

auto Value::to_string() const -> std::string {
  return std::visit(
      []<class T>(T const& held) -> std::string {
        if constexpr (std::is_same_v<T, std::monostate>)
          return {};
        else if constexpr (std::is_same_v<T, bool>)
          return held ? "true" : "false";
        else if constexpr (std::is_same_v<T, std::int64_t>)
          return std::to_string(held);
        else if constexpr (std::is_same_v<T, double>)
          return std::format("{}", held);
        else if constexpr (std::is_same_v<T, std::string>)
          return held;
        else
          throw std::runtime_error{"adelie: cannot render a view value of composite type as text"};
      },
      storage_->data);
}

}
