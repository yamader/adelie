module;

#include <cstdint>
#include <initializer_list>
#include <string>
#include <string_view>
#include <utility>

export module adelie.facades.config;

export namespace adelie::facades {

class Config {
 public:
  Config() = delete;

  static auto defaults(std::initializer_list<std::pair<std::string_view, std::string_view>> values) -> void;
  static auto set(std::string_view key, std::string value) -> void;
  static auto unset(std::string_view key) -> void;
  static auto clear() -> void;
  static auto has(std::string_view key) -> bool;
  static auto get(std::string_view key) -> std::string;
  static auto get(std::string_view key, std::string_view fallback) -> std::string;
  static auto get_int(std::string_view key, std::int64_t fallback = 0) -> std::int64_t;
  static auto get_bool(std::string_view key, bool fallback = false) -> bool;
};

}
