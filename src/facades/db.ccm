module;

#include <cstdint>
#include <string_view>
#include <utility>
#include <vector>

export module adelie.facades.db;

export import adelie.db;
export import adelie.support.callable;

export namespace adelie::facades {

class DB {
 public:
  DB() = delete;

  static auto manager() noexcept -> db::DatabaseManager& {
    static db::DatabaseManager instance;
    return instance;
  }

  static auto connect(db::Config config) -> void { manager().connect(std::move(config)); }

  static auto connect(std::string_view name, db::Config config) -> void { manager().connect(name, std::move(config)); }

  static auto session(std::string_view name = "default") -> db::Session& { return manager().session(name); }

  static auto execute(std::string_view sql) -> db::ResultSet { return session().execute(sql); }

  static auto execute(std::string_view sql, std::vector<db::Value> const& params) -> db::ResultSet {
    return session().execute(sql, params);
  }

  static auto last_insert_id() -> std::int64_t { return session().last_insert_id(); }

  static auto affected_rows() -> std::int64_t { return session().affected_rows(); }

  static auto in_transaction() -> bool { return session().in_transaction(); }

  static auto begin() -> void { session().begin(); }

  static auto commit() -> void { session().commit(); }

  static auto rollback() -> void { session().rollback(); }

  static auto transaction(support::Callable<void()> body) -> void { transaction(session(), std::move(body)); }

  static auto transaction(db::Session& target, support::Callable<void()> body) -> void {
    db::Transaction transaction(target);
    body();
    transaction.commit();
  }

  static auto disconnect_all() -> void { manager().disconnect_all(); }
};

}
