export module example.controllers;

import std;
import adelie;
import example.models;

export namespace example {

using adelie::Next;
using adelie::Request;
using adelie::Response;
using adelie::Status;

class Logger {
 public:
  auto note(std::string_view message) -> void {
    ++count_;
    last_ = message;
  }

  auto count() const noexcept -> int { return count_; }
  auto last() const noexcept -> std::string_view { return last_; }

 private:
  int count_ = 0;
  std::string last_;
};

class UserSource {
 public:
  virtual ~UserSource() = default;
  virtual auto find(std::string_view id) const -> std::string = 0;
  virtual auto count() const -> int = 0;
};

class UserRepository : public UserSource {
 public:
  explicit UserRepository(Logger& log) : log_{&log} {}

  auto find(std::string_view id) const -> std::string override {
    log_->note("repository.find");
    auto user = User::find(std::stoll(std::string{id}));
    if (!user) return "unknown";
    return std::string{user->get("name").as_string()};
  }

  auto count() const -> int override {
    log_->note("repository.count");
    return static_cast<int>(User::count());
  }

 private:
  Logger* log_;
};

class HomeController {
 public:
  auto index(Request const&) -> Response { return Response::text("Adelie"); }
};

class UserController {
 public:
  UserController(UserSource& users, Logger& log) : users_{&users}, log_{&log} {}

  auto index(Request const&) -> Response {
    adelie::view::Array rows;
    for (auto const& user : User::all())
      rows.push_back(adelie::view::Value{{"id", static_cast<std::int64_t>(user.key())},
                                         {"name", std::string{user.get("name").as_string()}}});

    return view("users.index", {{"app", Config::get("app.name")},
                                {"count", static_cast<std::int64_t>(users_->count())},
                                {"users", adelie::view::Value{std::move(rows)}},
                                {"log", static_cast<std::int64_t>(log_->count())}});
  }

  auto show(Request const& req) -> Response {
    return Response::json(
        {{"id", req.route("id")}, {"name", users_->find(req.route("id"))}, {"log", std::to_string(log_->count())}});
  }

  auto store(Request const& req) -> Response {
    std::string name{req.body()};
    if (name.empty()) name = "anonymous";
    auto user = User::create({{"name", name}});
    return Response::json({{"id", std::to_string(user.key())}, {"name", name}}, Status::created);
  }

  auto destroy(Request const&) -> Response { return Response::no_content(); }

 private:
  UserSource* users_;
  Logger* log_;
};

class DashboardController {
 public:
  auto show(Request const& req) -> Response {
    auto const user = adelie::auth::current_user(req);
    return Response::json(
        {{"route", req.route_name()}, {"user", user ? user->name : "anonymous"}, {"role", user ? user->role : ""}});
  }
};

}
